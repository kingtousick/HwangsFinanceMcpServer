# 선택적 폴백 소스용 API 키. 없으면 해당 소스는 건너뛴다.
# 한국수출입은행 환율 API (가정용 PC 환율 폴백). https://www.koreaexim.go.kr 에서 발급.
EXIM_API_KEY=
# Finnhub (미국 주식 폴백, 현재 미사용/예약).
FINNHUB_KEY=
# 국토교통부 실거래가 API (data.go.kr 활용신청 후 발급되는 'Decoding(일반)' 키).
# get_apt_trade / get_apt_rent 에 필요. Encoding 키를 넣으면 이중 인코딩으로 깨짐.
# 세대수 도구(get_apt_complex_info, get_apt_trade_summary의 households/turnover_rate)도
# 같은 키를 쓴다. 단 아래 2개 데이터셋을 data.go.kr에서 추가 활용신청해야 함:
#   - 국토교통부_공동주택 단지 목록제공 서비스   (시군구 → 단지코드)
#   - 국토교통부_공동주택 기본 정보제공 서비스   (단지코드 → 세대수/동수/사용승인일)
# 미신청이어도 실거래 집계는 정상 동작하고 세대수 필드만 None으로 빠진다.
MOLIT_API_KEY=

# --- 공사현황(철도/광역교통) 도구 ---------------------------------------------
# data.go.kr Decoding(일반) 키. 계정 단위라 MOLIT_API_KEY와 동일 키를 쓰면 된다
# (미설정 시 MOLIT_API_KEY로 폴백). 단, 각 서비스를 data.go.kr에서 별도 활용신청해야 함:
#   - 나라장터 입찰공고정보서비스   → get_construction_bids
#   - (관보고시는 파일데이터이며 아래 URL 환경변수 사용)
DATA_GO_KR_API_KEY=

# 열린재정(openfiscaldata.go.kr) OpenAPI 인증키. get_project_budget 에 필요.
# 데이터셋 "(OPEN API) 세출/지출 예산편성현황(총지출)" = 경로형 API 'TotalExpenditure5'.
OPEN_FISCAL_API_KEY=
# 아래는 코드 기본값(2026-07-06 실호출로 확정)이라 보통 설정 불필요하다. 다른 데이터셋을
# 쓰거나 파라미터명이 바뀔 때만 덮어쓴다. 열린재정은 API마다 방식이 달라 경로형/SERVICE형이
# 섞여 있는데, 이 API는 경로형(base/<API명>?FSCL_YY=..&SACTV_NM=..)이다. sources/fiscal.py 참고.
# ※ 기본값을 쓰려면 반드시 줄 전체를 주석 처리할 것. `KEY=`(빈 값)으로 두면 코드 기본값 대신
#   빈 문자열이 먹어 예산 API가 ERROR-310("서비스를 찾을 수 없습니다")으로 깨진다.
#   OPEN_FISCAL_API_NAME          : 경로형 API명 (기본 'TotalExpenditure5')
#   OPEN_FISCAL_KW_PARAM          : 세부사업명 검색 파라미터 (기본 'SACTV_NM')
#   OPEN_FISCAL_BDG_FND_DIV_CD    : 예산기금구분 0전체/1예산/5기금 (기본 '1')
#   OPEN_FISCAL_ANEXP_INQ_STND_CD : 세출조회기준 1총계/2세출순계 (기본 '1')
# OPEN_FISCAL_API_NAME=
# OPEN_FISCAL_KW_PARAM=

# 국가철도공단 관보고시 오픈API 엔드포인트 URL. get_rail_notices 에 필요.
# ※ 여기는 '인증키'가 아니라 URL 자리다. data.go.kr 파일데이터(15114027 등)는 odcloud.kr
#   오픈API로 자동변환되며, 데이터셋의 'OpenAPI/미리보기' 탭에 아래 형태의 URL이 있다:
#     https://api.odcloud.kr/api/15114027/v1/uddi:xxxxxxxx-....
#   serviceKey는 코드가 DATA_GO_KR_API_KEY(=MOLIT_API_KEY)로 자동 첨부하므로 URL만 넣는다.
KRNA_NOTICE_URL_BASIC=
KRNA_NOTICE_URL_PLAN=
KRNA_NOTICE_URL_DETAIL=

# --- 포트폴리오 점검 도구 -------------------------------------------------------
# DART 전자공시 OpenAPI 인증키. search_stock_code / get_dart_disclosures 에 필요.
# https://opendart.fss.or.kr > 인증키 신청 (무료, 즉시 발급).
DART_API_KEY=
# 한국은행 ECOS OpenAPI 인증키. get_macro_indicators 에 필요.
# https://ecos.bok.or.kr > Open API > 인증키 신청 (무료).
ECOS_API_KEY=
# 포트폴리오 파일 경로(선택). get_portfolio_snapshot 이 path 인자 없이 호출될 때 사용.
# 미설정 시 './portfolio.json'. 스키마는 README '포트폴리오 스냅샷' 참고.
# ※ 개인 자산 정보이므로 저장소에 커밋하지 말 것(.gitignore에 portfolio.* 등록됨).
PORTFOLIO_FILE_PATH=

# --- 미국 종목 펀더멘털(SEC EDGAR) ---------------------------------------------
# SEC EDGAR는 '이름 이메일' 형식의 User-Agent를 요구하며 없으면 403을 반환한다.
# 인증키가 아니라 '연락처'다 — SEC가 과다 조회 시 연락할 수 있도록 실제로 받는
# 이메일을 넣는다(https://www.sec.gov/os/webmaster-faq#developers).
# get_sec_annual_metrics / get_implied_useful_life / get_capex_series /
# get_sec_fundamentals / get_rpo_backlog 에 필요. 미설정 시 403이 아니라 안내
# 메시지를 errors[]로 돌려준다.
#   예: SEC_USER_AGENT="Hong Gildong hong@example.com"
# ※ naver.com 주소는 쓰지 말 것 — SEC(Akamai) WAF가 도메인 단위로 차단해 계정명·
#    회사명을 어떻게 바꿔도 403 "Undeclared Automated Tool"이 반환된다(2026-09-02 실측).
#    gmail.com / outlook.com / daum.net / kakao.com / 자체 도메인은 정상 통과.
SEC_USER_AGENT=
# get_global_valuation(야후)과 get_credit_spreads(FRED)는 키·UA가 필요 없다.

# HTTP 응답 파일 캐시 경로(선택). SEC 티커목록(약 1MB)과 공시 응답을 재기동 후에도
# 재사용해 재다운로드를 막는다. 미설정 시 %LOCALAPPDATA%\finance-mcp\cache
# (그 외 OS는 ~/.cache/finance-mcp). 지워도 동작에 영향 없다.
FINANCE_MCP_CACHE_DIR=
